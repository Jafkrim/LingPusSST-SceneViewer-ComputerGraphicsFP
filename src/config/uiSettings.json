{
  "storageKey": "lingpus_sst_ui_settings_v1",
  "theme": "builtInDark",
  "viewMode": 1,
  "hudHidden": false,
  "uiScale": {
    "value": 100,
    "min": 80,
    "max": 160,
    "step": 5
  },
  "animations": {
    "enabled": true,
    "durationMs": 160,
    "fade": true,
    "slide": true,
    "pie": true
  },
  "panels": {
    "settingsVisible": false,
    "statsVisible": true,
    "contentBrowserVisible": true,
    "editorVisible": true,
    "viewportGizmoVisible": true
  },
  "settingsPanel": {
    "title": "Settings",
    "closeLabel": "×",
    "closeTitle": "Close Settings",
    "widthPx": 560,
    "minHeightPx": 360,
    "maxHeightVh": 85,
    "collapsedSections": {
      "Content Browser": true,
      "Appearance": true,
      "Keybinds": true
    },
    "sections": {
      "appearance": {
        "title": "Appearance",
        "themeLabel": "Theme",
        "scaleLabel": "UI Scale"
      },
      "contentBrowser": {
        "title": "Content Browser",
        "formatOptions": [
          {
            "key": "exr",
            "label": "Preview EXR (.exr)"
          },
          {
            "key": "glb",
            "label": "Preview GLB (.glb)"
          },
          {
            "key": "gltf",
            "label": "Preview GLTF (.gltf)"
          },
          {
            "key": "hdr",
            "label": "Preview HDR (.hdr)"
          },
          {
            "key": "prefab",
            "label": "Preview Prefabs (.prefab.json)"
          },
          {
            "key": "texture",
            "label": "Preview Textures (.png, .jpg, .webp, .tga)"
          }
        ]
      },
      "keybinds": {
        "title": "Keybinds",
        "resetLabel": "Reset Defaults",
        "unboundLabel": "Unbound",
        "capturingLabel": "Press key..."
      }
    }
  },
  "renderPanel": {
    "collapsedSections": {
      "Viewport Guides": true
    }
  },
  "editorPanel": {
    "widthPx": 300,
    "hierarchyHeightPx": 221,
    "hierarchyMinHeightPx": 90,
    "hierarchyMaxHeightPx": 560,
    "activeTab": "render"
  },
  "inspectorPanel": {
    "emptyText": "Select an object to inspect",
    "transformSectionTitle": "Transform",
    "fallbackCssVar": "--accent-primary",
    "rows": [
      {
        "key": "position",
        "label": "Location",
        "unit": "m",
        "step": 0.01,
        "precision": 4,
        "defaultValue": [
          0,
          0,
          0
        ],
        "resetTitle": "Reset Location"
      },
      {
        "key": "rotation",
        "label": "Rotation",
        "unit": "°",
        "step": 0.5,
        "precision": 4,
        "defaultValue": [
          0,
          0,
          0
        ],
        "resetTitle": "Reset Rotation"
      },
      {
        "key": "scale",
        "label": "Scale",
        "unit": "",
        "step": 0.01,
        "precision": 4,
        "defaultValue": [
          1,
          1,
          1
        ],
        "resetTitle": "Reset Scale",
        "uniformToggle": {
          "enabledDefault": true,
          "label": "Uniform",
          "title": "Toggle Uniform Scale"
        }
      }
    ],
    "axes": [
      {
        "index": 0,
        "label": "X",
        "cssVar": "--axis-x"
      },
      {
        "index": 1,
        "label": "Y",
        "cssVar": "--axis-y"
      },
      {
        "index": 2,
        "label": "Z",
        "cssVar": "--axis-z"
      }
    ]
  },
  "placementTool": {
    "allowedCategories": [
      "models",
      "prefabs"
    ],
    "defaultDropDistance": 12,
    "maxGroundDistance": 250,
    "snapToSurface": true,
    "snapToNearestVertex": true,
    "vertexSnapRadius": 0.45,
    "alignToSurfaceNormal": false
  },
  "viewportGizmo": {
    "sizePx": 84,
    "armLengthPx": 26,
    "labelOffsetPx": 9,
    "lineWidthPx": 2.5
  },
  "pieMenu": {
    "radiusPx": 116,
    "verticalFactor": 0.64,
    "deadzonePx": 22,
    "ringRadiusPx": 18,
    "edgePaddingPx": 16,
    "menus": {
      "panels": {
        "startAngleDeg": -135,
        "items": [
          {
            "id": "stats",
            "label": "Statistics",
            "event": "ui:togglePanel",
            "payload": {
              "panel": "stats"
            }
          },
          {
            "id": "viewportGizmo",
            "label": "Gizmo",
            "event": "ui:togglePanel",
            "payload": {
              "panel": "viewportGizmo"
            }
          },
          {
            "id": "editor",
            "label": "Panel",
            "event": "ui:togglePanel",
            "payload": {
              "panel": "editor"
            }
          },
          {
            "id": "settings",
            "label": "Settings",
            "event": "ui:togglePanel",
            "payload": {
              "panel": "settings"
            }
          }
        ]
      },
      "camera": {
        "startAngleDeg": 180,
        "items": [
          {
            "id": "perspective",
            "label": "Perspective",
            "event": "camera:setProjection",
            "payload": {
              "projection": "perspective"
            }
          },
          {
            "id": "orthographic",
            "label": "Orthographic",
            "event": "camera:setProjection",
            "payload": {
              "projection": "orthographic"
            }
          }
        ]
      }
    }
  },
  "viewportGuides": {
    "grid": true,
    "axisX": true,
    "axisY": true,
    "axisZ": true
  },
  "sceneSave": {
    "defaultDirectory": "",
    "defaultName": "untitled",
    "extension": ".scene.json",
    "allowedModes": [
      "surveyor"
    ]
  },
  "sceneActions": {
    "allowedModes": [
      "surveyor"
    ]
  },
